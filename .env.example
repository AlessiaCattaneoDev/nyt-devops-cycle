# ============================================================================
#  .env  —  copia questo file in `.env` e compila i valori.
#  `.env` e' in .gitignore: NON deve mai essere committato.
#  Questi valori sono consumati dal servizio `backend` di docker-compose
#  (env_file) e, in staging/produzione, replicati come Environment Variables
#  del progetto Vercel.
# ============================================================================

# ---- Secret NYT (obbligatori) --------------------------------------------
# Ottienili creando due app su https://developer.nytimes.com/apps
#   - una con accesso "Top Stories API"
#   - una con accesso "Most Popular API"
NYT_TOP_STORIES_KEY=changeme
NYT_MOST_POPULAR_KEY=changeme

# ---- Ambiente logico ----------------------------------------------------
# development | staging | production
APP_ENV=development

# ---- Cache del proxy --------------------------------------------------
# TTL in ms delle risposte NYT tenute in memoria (0 = disabilita la cache)
PROXY_CACHE_TTL_MS=300000

# ---- Sentry (error tracking lato server) -----------------------------
# Lascia vuoto per disabilitare (tipico in locale).
SENTRY_DSN_BACKEND=
SENTRY_ENVIRONMENT=development

# ---- Endpoint di debug ------------------------------------------------
# Abilita /api/debug/boom e la rotta frontend /debug/boom.
# In produzione tienilo a "false", portalo a "true" solo per la demo di monitoraggio.
DEBUG_ENDPOINTS=true

# ---- CORS (solo backend Express locale) -----------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
