# Frontend — variabili di build/runtime (prefisso VITE_ = esposte al browser).
# NON mettere qui segreti: tutto cio' che ha prefisso VITE_ finisce nel bundle.
# Le API key NYT stanno solo lato server (vedi .env alla radice del repo).

VITE_APP_ENV=development

# DSN pubblico di Sentry per il frontend (vuoto = error tracking disattivato)
VITE_SENTRY_DSN=

# Release per Sentry (di norma lo SHA del commit); vuoto in locale
VITE_APP_RELEASE=

# Abilita la rotta /debug/boom anche fuori da development
VITE_DEBUG_ENDPOINTS=true

# Override opzionale del base URL del BFF
# VITE_API_BASE_URL=/api/nyt
